#!/usr/bin/env python3
"""以目前工作目錄的絕對路徑安裝每月四次的 LaunchAgent。"""

import os
from pathlib import Path
import plistlib
import subprocess
import sys


def main():
    root = Path(__file__).resolve().parent.parent
    with (root / "launchd/example.weekly.plist").open("rb") as source:
        agent = plistlib.load(source)
    placeholder = "/absolute/path/to/home-market-tracker"
    agent["ProgramArguments"] = [str(root / "bin/send-weekly")]
    for key in ("WorkingDirectory", "StandardOutPath", "StandardErrorPath"):
        agent[key] = agent[key].replace(placeholder, str(root))
    agent["EnvironmentVariables"] = {
        "PATH": f"{Path(sys.executable).parent}:/usr/bin:/bin:/usr/sbin:/sbin"
    }

    # Fail before registering a scheduled send if its Python dependency is missing.
    subprocess.run([sys.executable, "-c", "import yaml"], check=True)
    (root / "data/state").mkdir(parents=True, exist_ok=True)
    destination = Path.home() / "Library/LaunchAgents" / f"{agent['Label']}.plist"
    destination.parent.mkdir(parents=True, exist_ok=True)
    domain = f"gui/{os.getuid()}"
    service = f"{domain}/{agent['Label']}"
    loaded = subprocess.run(
        ["launchctl", "print", service],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if loaded.returncode == 0:
        subprocess.run(["launchctl", "bootout", service], check=True)
    with destination.open("wb") as output:
        plistlib.dump(agent, output)
    subprocess.run(["launchctl", "bootstrap", domain, str(destination)], check=True)
    print(f"Installed {destination}")
    print("已排程於每月 1、8、15、22 日，本機時間 08:00 執行。安裝過程不會寄信。")


if __name__ == "__main__":
    main()
